# Copy to .env and fill in. Used by `docker compose` (web + worker) and by `npm run dev`.

# --- Slack sign-in (Auth.js, OpenID Connect) -------------------------------
# Random secret for session cookies: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# Slack app > Basic Information > App Credentials
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=
# The https URL people open Botley at. Slack redirect URL = $AUTH_URL/api/auth/callback/slack
AUTH_URL=https://localhost
# Only this workspace may sign in (Slack team ID, starts with T)
SLACK_TEAM_ID=
# Comma-separated Slack user IDs that become admins on their first sign-in
ADMIN_SLACK_USER_IDS=

# --- Slack bot (worker, Socket Mode) ----------------------------------------
# Bot User OAuth Token (OAuth & Permissions) and an app-level token with connections:write
# (Basic Information > App-Level Tokens). Unset = the worker runs without Slack.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Where Slack "Open in dashboard" links point. Default: AUTH_URL.
APP_URL=

# --- Secrets at rest -------------------------------------------------------
# 32-byte key (base64 or hex) that encrypts Data Source credentials: `openssl rand -base64 32`
# Keep it safe and stable: changing it makes saved credentials unreadable.
ENCRYPTION_KEY=

# --- LLM ---------------------------------------------------------------------
# Admins choose the provider and model in Admin > Settings, from the models each provider
# lists (no restart). Until they do, Botley can't answer (Answers fail with a friendly message).
# Optional: the provider pre-selected there: anthropic | openai | google | openrouter | groq | ollama.
LLM_PROVIDER=
# Keys for the providers admins may choose (the one for LLM_PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Ollama's API URL (default http://localhost:11434/api)
OLLAMA_BASE_URL=

# --- MongoDB ---------------------------------------------------------------
# Only for `npm run dev`; compose always points web/worker at its bundled `mongo` service
# MONGO_URL=mongodb://localhost:27017
MONGO_DB=botley

# --- Uploads ------------------------------------------------------------------
# Where uploaded CSV/XLSX Datasets are stored as Parquet files. Web and worker must share it.
# Only for `npm run dev` (default ./data/uploads); compose always uses its shared volume at /data/uploads.
# UPLOADS_DIR=data/uploads

# --- Networking (compose) --------------------------------------------------
# Host port for web over plain http
WEB_PORT=3000
# Hostname Caddy serves with an internal TLS certificate (profile `https`)
SITE_ADDRESS=localhost
